{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@redproof/knip": ["packages/knip/src/index.ts"],
      "redproof": [
        "packages/redproof/src/index.ts"
      ],
      "redproof/command": [
        "packages/redproof/src/command/index.ts"
      ],
      "@redproof/adapter-tck": [
        "packages/adapter-tck/src/index.ts"
      ],
      "@redproof/eslint": [
        "packages/eslint/src/index.ts"
      ],
      "@redproof/dependency-cruiser": [
        "packages/dependency-cruiser/src/index.ts"
      ],
      "@redproof/stryker": [
        "packages/stryker/src/index.ts"
      ],
      "@redproof/istanbul": ["packages/istanbul/src/index.ts"],
      "@redproof/testing": [
        "packages/testing/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "gates/**/*.ts",
    "redproof.config.ts"
  ]
}
