{
  "name": "redproof",
  "version": "0.9.0",
  "description": "Prove your guardrails can fail. Redproof verifies that tests, linters, and architecture rules actually go red.",
  "keywords": [
    "testing",
    "guardrails",
    "mutation-testing",
    "lint",
    "quality-gate"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./command": {
      "types": "./dist/command/index.d.ts",
      "default": "./dist/command/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "redproof": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schalermthai/redproof.git",
    "directory": "packages/redproof"
  },
  "license": "Apache-2.0"
}
