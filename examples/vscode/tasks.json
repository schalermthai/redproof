{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "redproof",
      "type": "shell",
      "command": "npx redproof check --reporter=compact",
      "problemMatcher": {
        "owner": "redproof",
        "source": "redproof",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): error redproof\\[([^\\]]+)\\]: (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    }
  ]
}
